# ---------------------------------------------------------------------------
# DM Tech Payroll — branding / tenant config
# Copy this file to `.env` and edit. Only VITE_* vars are read (Vite),
# and only at dev/build start — restart `npm run dev` after changing.
# Any value left blank falls back to the defaults in src/config/brand.ts.
# ---------------------------------------------------------------------------

# --- Client / tenant (the business running payroll) ---
VITE_COMPANY_NAME="Toko Jam Arloji Prima"
VITE_COMPANY_LEGAL_NAME="TOKO JAM ARLOJI PRIMA"
VITE_COMPANY_INITIALS="AP"
VITE_COMPANY_ADDRESS="Jl. Pasar Baru No. 27, Jakarta Pusat"
VITE_COMPANY_NPWP="09.254.117.3-021.000"

# --- Software vendor (DM Tech) — leave as-is unless rebranding the product ---
VITE_VENDOR_NAME="DM Tech"
VITE_VENDOR_INITIALS="DM"          # monogram for the DRAWN fallback logo only
VITE_LOGO_SRC="/brand-logo.svg"    # real logo: put the file in public/ (png or svg)
VITE_PRODUCT_NAME="Payroll Suite"
VITE_VENDOR_URL="dm.tech"
VITE_APP_VERSION="0.1.0"
