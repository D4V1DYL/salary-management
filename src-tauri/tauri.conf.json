{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DM Tech Payroll",
  "version": "0.1.0",
  "identifier": "tech.dm.payroll",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DM Tech Payroll",
        "width": 1280,
        "height": 832,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "DM Tech",
    "copyright": "© 2026 DM Tech",
    "category": "Business",
    "shortDescription": "Payroll desktop offline untuk toko — SQLite terenkripsi, anti-copy.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
